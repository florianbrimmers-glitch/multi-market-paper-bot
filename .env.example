# Copy to .env and fill in. NEVER commit real keys.

# Alpaca PAPER account keys (https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Anthropic key for the daily briefs (optional — a plain template is used without it)
ANTHROPIC_API_KEY=

# true = evaluate + log intended orders only (default); false = place PAPER orders
DRY_RUN=true

# Optional overrides (defaults in config.py)
# RISK_PER_TRADE_PCT=0.005   # fraction of equity risked per trade
# MAX_STOP_PCT=0.01          # hard stop-loss cap (1%)
# ATR_STOP_MULT=1.5          # stop distance = this * ATR, before the cap
# MAX_POSITION_PCT=0.25      # max single-position notional as fraction of equity
# DECISION_LOG_PATH=trade_decisions.jsonl
